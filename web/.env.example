# Copy to .env.local for local development (Vite loads .env.local automatically and
# it is git-ignored). These point the web client at the FastAPI server; see
# docker-compose.yml for how nginx wires the built client to the server in containers.

VITE_APP_NAME=Beam
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
