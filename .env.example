# Copy to .env and fill in real secrets before running `docker compose up --build`:
#
#   cp .env.example .env
#   ./scripts/gen_secrets.sh   # fills JWT_SECRET, CODE_PEPPER and TURN_SECRET below
#
# No API keys or paid services are needed anywhere in this project. .env is
# git-ignored; only this .example file is committed. See docs/security.md.

ENV=development
APP_NAME=Beam
LOG_LEVEL=INFO
LOG_FORMAT=console

# Space-separated list of browser origins allowed to call the API / open the
# signaling WebSocket. The web client is served from nginx on :8080 in compose.
ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:5173"]

REDIS_URL=redis://redis:6379/0

# Accounts + transfer history (Milestone 11). docker-compose.yml already overrides
# this to point at the bundled postgres service; leave blank to disable that API
# surface entirely (see config.py's database_url).
DATABASE_URL=postgresql+asyncpg://beam:beam@postgres:5432/beam  # pragma: allowlist secret

# TURN URLs advertised alongside minted credentials (docs/adr/004). docker-compose.yml
# already overrides this to point at the bundled coturn service for localhost testing;
# set it yourself only when running the server outside that compose stack (e.g. coturn
# on a different host, or a production domain instead of localhost).
# TURN_URLS=["turn:localhost:3478?transport=udp","turn:localhost:3478?transport=tcp"]

# --- Secrets -----------------------------------------------------------------
# Each must be at least 32 bytes. Leave blank only when ENV=test.
JWT_SECRET=
CODE_PEPPER=
TURN_SECRET=
